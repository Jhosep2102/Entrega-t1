@model Pedido
@{
    ViewData["Title"] = "Editar pedido";
}

<h2 class="mb-4">Editar pedido</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.PedidoId" method="post">
            <input type="hidden" asp-for="PedidoId" />
            <div class="mb-3">
                <label asp-for="FechaPedido" class="form-label">Fecha</label>
                <input asp-for="FechaPedido" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                <span asp-validation-for="FechaPedido" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Monto" class="form-label">Monto</label>
                <input asp-for="Monto" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="Monto" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Estado" class="form-label">Estado</label>
                <select asp-for="Estado" asp-items="ViewBag.Estados" class="form-select"></select>
                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ClienteId" class="form-label">Cliente</label>
                <select asp-for="ClienteId" asp-items="ViewBag.Clientes" class="form-select"></select>
                <span asp-validation-for="ClienteId" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a class="btn btn-secondary" asp-action="Index">Volver</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
